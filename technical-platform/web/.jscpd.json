{
  "threshold": 8,
  "minLines": 8,
  "minTokens": 70,
  "maxLines": 1000,
  "reporters": ["console", "json"],
  "output": "reports/jscpd",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/reports/**",
    "**/*.test.ts",
    "**/runtimeTestHost.ts"
  ],
  "format": ["typescript", "vue", "css"]
}
