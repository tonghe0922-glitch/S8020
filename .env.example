# Local development only. Copy to .env and replace every __SET_LOCAL_*__ value.
# Bootstrap is PostgreSQL container administration only. API/Worker MUST NOT use it.
POSTGRES_USER=sjg_bootstrap
POSTGRES_PASSWORD=__SET_LOCAL_POSTGRES_BOOTSTRAP_PASSWORD__
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Dedicated migration identity; schema/DDL changes run only through the migration runner.
SJG_BOOTSTRAP_DB_URL=jdbc:postgresql://localhost:5432/postgres
SJG_BOOTSTRAP_DB_USERNAME=sjg_bootstrap
SJG_BOOTSTRAP_DB_PASSWORD=__SET_LOCAL_POSTGRES_BOOTSTRAP_PASSWORD__
SJG_MIGRATION_DB_USERNAME=sjg_migration
SJG_MIGRATION_DB_PASSWORD=__SET_LOCAL_MIGRATION_DB_PASSWORD__
SJG_OMS_MIGRATION_DB_URL=jdbc:postgresql://localhost:5432/sjg_oms
SJG_AUDIT_MIGRATION_DB_URL=jdbc:postgresql://localhost:5432/sjg_audit
SJG_DW_MIGRATION_DB_URL=jdbc:postgresql://localhost:5432/sjg_dw

# Runtime application identities; no DDL / CREATE / BYPASSRLS privileges.
SJG_API_DB_URL=jdbc:postgresql://localhost:5432/sjg_oms
SJG_API_DB_USERNAME=sjg_api_runtime
SJG_API_DB_PASSWORD=__SET_LOCAL_API_DB_PASSWORD__
SJG_WORKER_DB_URL=jdbc:postgresql://localhost:5432/sjg_oms
SJG_WORKER_DB_USERNAME=sjg_worker_runtime
SJG_WORKER_DB_PASSWORD=__SET_LOCAL_WORKER_DB_PASSWORD__

# Additional least-privilege database principals provisioned by local bootstrap.
SJG_AUDIT_WRITER_DB_PASSWORD=__SET_LOCAL_AUDIT_WRITER_DB_PASSWORD__
SJG_AUDITOR_DB_PASSWORD=__SET_LOCAL_AUDITOR_DB_PASSWORD__
SJG_DW_WRITER_DB_PASSWORD=__SET_LOCAL_DW_WRITER_DB_PASSWORD__
SJG_DW_READER_DB_PASSWORD=__SET_LOCAL_DW_READER_DB_PASSWORD__

# Required deployment facts for the approved tenant-scoped seed. No production default is committed.
SJG_TENANT_ID=__SET_LOCAL_TENANT_ID__
SJG_TENANT_CODE=__SET_LOCAL_TENANT_CODE__
SJG_TENANT_NAME=__SET_LOCAL_TENANT_NAME__

REDIS_PORT=6379
MINIO_ROOT_USER=__SET_LOCAL_MINIO_USER__
MINIO_ROOT_PASSWORD=__SET_LOCAL_MINIO_PASSWORD__
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_DEFAULT_USER=__SET_LOCAL_RABBIT_USER__
RABBITMQ_DEFAULT_PASS=__SET_LOCAL_RABBIT_PASSWORD__
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
API_PORT=8080
TECH_WEB_PORT=5175

WORK_WEB_PORT=5173
