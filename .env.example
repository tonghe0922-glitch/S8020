# S8020 local development only.
# 1) Copy this file to .env.
# 2) Replace every __SET_LOCAL_*__ placeholder before starting services.
# 3) Never commit .env or a plaintext administrator password.

# PostgreSQL container bootstrap identity. API/Worker MUST NOT use this account.
POSTGRES_USER=sjg_bootstrap
POSTGRES_PASSWORD=__SET_LOCAL_POSTGRES_BOOTSTRAP_PASSWORD__
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Dedicated migration identity; schema/DDL changes run only through the migration runner.
SJG_BOOTSTRAP_DB_URL=jdbc:postgresql://127.0.0.1:5432/postgres
SJG_BOOTSTRAP_DB_USERNAME=sjg_bootstrap
SJG_BOOTSTRAP_DB_PASSWORD=__SET_LOCAL_POSTGRES_BOOTSTRAP_PASSWORD__
SJG_MIGRATION_DB_USERNAME=sjg_migration
SJG_MIGRATION_DB_PASSWORD=__SET_LOCAL_MIGRATION_DB_PASSWORD__
SJG_OMS_MIGRATION_DB_URL=jdbc:postgresql://127.0.0.1:5432/sjg_oms
SJG_AUDIT_MIGRATION_DB_URL=jdbc:postgresql://127.0.0.1:5432/sjg_audit
SJG_DW_MIGRATION_DB_URL=jdbc:postgresql://127.0.0.1:5432/sjg_dw

# Runtime application identities; no DDL / CREATE / BYPASSRLS privileges.
SJG_API_DB_URL=jdbc:postgresql://127.0.0.1:5432/sjg_oms
SJG_API_DB_USERNAME=sjg_api_runtime
SJG_API_DB_PASSWORD=__SET_LOCAL_API_DB_PASSWORD__
SJG_WORKER_DB_URL=jdbc:postgresql://127.0.0.1:5432/sjg_oms
SJG_WORKER_DB_USERNAME=sjg_worker_runtime
SJG_WORKER_DB_PASSWORD=__SET_LOCAL_WORKER_DB_PASSWORD__

# Additional least-privilege database principals provisioned by local bootstrap.
SJG_AUDIT_WRITER_DB_PASSWORD=__SET_LOCAL_AUDIT_WRITER_DB_PASSWORD__
SJG_AUDITOR_DB_PASSWORD=__SET_LOCAL_AUDITOR_DB_PASSWORD__
SJG_DW_WRITER_DB_PASSWORD=__SET_LOCAL_DW_WRITER_DB_PASSWORD__
SJG_DW_READER_DB_PASSWORD=__SET_LOCAL_DW_READER_DB_PASSWORD__

# API audit datasource. The password intentionally reuses the provisioned audit-writer secret.
SJG_AUDIT_DB_URL=jdbc:postgresql://127.0.0.1:5432/sjg_audit
SJG_AUDIT_DB_USERNAME=sjg_audit_writer
SJG_AUDIT_DB_PASSWORD=${SJG_AUDIT_WRITER_DB_PASSWORD}
# Local development defaults to fail-open. Production deployments must use fail-closed.
SJG_SECURITY_AUDIT_MODE=fail-open

# Redis-backed opaque session store.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Required deployment facts for tenant-scoped seeds. No production default is committed.
SJG_TENANT_ID=__SET_LOCAL_TENANT_ID__
SJG_TENANT_CODE=__SET_LOCAL_TENANT_CODE__
SJG_TENANT_NAME=__SET_LOCAL_TENANT_NAME__

# Controlled first administrator bootstrap.
SJG_ADMIN_LOGIN_NAME=admin
SJG_ADMIN_EMPLOYEE_NO=S8020-E001
# Generate a BCrypt cost=12 hash outside Git; put only the hash below.
# Example (requires Python package bcrypt):
# python3 -c "import bcrypt; print(bcrypt.hashpw(b'<password>', bcrypt.gensalt(rounds=12)).decode())"
# Keep single quotes so the BCrypt '$' characters survive shell loading unchanged.
SJG_ADMIN_PASSWORD_HASH='__SET_LOCAL_BCRYPT_HASH__'

# Supporting infrastructure.
MINIO_ROOT_USER=__SET_LOCAL_MINIO_USER__
MINIO_ROOT_PASSWORD=__SET_LOCAL_MINIO_PASSWORD__
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_DEFAULT_USER=__SET_LOCAL_RABBIT_USER__
RABBITMQ_DEFAULT_PASS=__SET_LOCAL_RABBIT_PASSWORD__
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Local application ports.
API_PORT=8080
WORK_WEB_PORT=5173
TECH_WEB_PORT=5175
